# Keep the build context small + avoid leaking local state into the image.

# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build
dist
.pnpm-store

# Local env / secrets — set these as Build Args (CI) / runtime env (Dokploy)
.env
.env.*
!.env.example

# VCS & CI
.git
.gitignore
.github
.vercel
.vercelignore
.infisical.json

# Tests, coverage, e2e artifacts (not needed at runtime)
coverage
playwright-report
test-results
tests
e2e
.auth

# Editor / OS cruft
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker meta
Dockerfile
.dockerignore

# Misc local-only
.husky
*.local
docs
scripts/backups
